# Server-side only (SIN prefijo VITE_): la usa api/chat.js, nunca llega al navegador.
ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui

# Frontend (con prefijo VITE_): la anon key de Supabase está pensada para ser
# pública, la protección real vive en las políticas RLS de supabase/schema.sql.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
