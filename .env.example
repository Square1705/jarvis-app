# Server-side only (SIN prefijo VITE_): la usa api/chat.js, nunca llega al navegador.
ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui

# Frontend (con prefijo VITE_): la anon key de Supabase está pensada para ser
# pública, la protección real vive en las políticas RLS de supabase/schema.sql.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- Bot de Telegram (server/, api/telegram-webhook.js, api/cron-daily-summary.js, api/webhook-supabase.js) ---
# Todo esto corre serverless en Vercel, sin servidor persistente.

# Token del bot (te lo da @BotFather) y tu chat_id personal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secreto que Telegram manda en cada webhook (lo defines tú al registrar el
# webhook con setWebhook) para verificar que la llamada es realmente de Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Mismas credenciales de Supabase pero SIN prefijo VITE_ (server-side) y con
# la service_role key (no la anon) — estas funciones no tienen sesión de
# usuario, así que bypasan RLS a propósito.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Tu user id de Supabase Auth (Authentication -> Users -> UUID de tu cuenta).
JARVIS_USER_ID=

# Secreto compartido con Supabase Database Webhooks (header x-webhook-secret).
SUPABASE_WEBHOOK_SECRET=

# Monto (S/) a partir del cual un gasto confirmado dispara aviso instantáneo.
GASTO_ALERTA_UMBRAL=300

# Secreto que Vercel manda como "Authorization: Bearer <esto>" al invocar
# el cron diario — ver https://vercel.com/docs/cron-jobs
CRON_SECRET=
