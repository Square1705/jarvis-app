# Token del bot, te lo da @BotFather en Telegram al crear el bot.
TELEGRAM_BOT_TOKEN=

# Tu chat_id personal de Telegram. Solo este chat puede hablarle al bot.
TELEGRAM_CHAT_ID=

# La misma key que usa api/chat.js en Vercel (puede ser la misma o una
# key distinta dedicada al bot, tu decides).
ANTHROPIC_API_KEY=

# URL de tu proyecto de Supabase (la misma que VITE_SUPABASE_URL en la app).
SUPABASE_URL=

# service_role key de Supabase (Settings -> API -> Secret keys). NUNCA la
# uses en el frontend — solo vive aquí, en el servidor del bot.
SUPABASE_SERVICE_ROLE_KEY=

# Tu user id de Supabase Auth (Authentication -> Users -> copia el UUID
# de tu cuenta). El bot solo opera sobre los datos de este usuario.
JARVIS_USER_ID=

# Hora (0-23) del resumen diario, hora de Lima. Default: 8.
DAILY_SUMMARY_HOUR=8

# Secreto compartido con Supabase Database Webhooks, para que solo Supabase
# pueda llamar a /webhook/supabase (avisos en tiempo real). Inventa un
# string largo y random, y pon el mismo valor en el header del webhook.
WEBHOOK_SECRET=

# Monto (S/) a partir del cual un gasto confirmado dispara un aviso
# instantáneo por Telegram. Default: 300.
GASTO_ALERTA_UMBRAL=300

# Puerto del servidor HTTP (/health, /webhook/supabase). Railway lo asigna
# solo, normalmente no hace falta tocarlo.
PORT=3000
